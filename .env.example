# Inkade Server Configuration
PORT=3456
HOST=0.0.0.0

# SQLite & Blob Storage Paths
INKADE_DB_PATH=./data/inkade.db
INKADE_DATA_DIR=./data

# Authentication (Better Auth)
# Generate a strong random string (32+ chars, e.g. `openssl rand -hex 32`) for production
INKADE_AUTH_SECRET=replace-with-a-random-32-char-secret
INKADE_BASE_URL=http://localhost:3456
# Set to true only if you explicitly want open self-registration after initial owner setup
# INKADE_ALLOW_SIGNUP=false

# Reverse Proxy / Cross-Origin Allowlists (comma-separated origins)
# INKADE_TRUSTED_ORIGINS=https://notes.example.com
# INKADE_CORS_ORIGINS=https://notes.example.com

# Interactive Artifact Sandbox Isolation
# Production requires a distinct registrable domain (recommended), e.g.:
# INKADE_APP_ORIGIN=https://notes.example.com
# INKADE_SANDBOX_ORIGIN=https://{id}.inkade-sandbox.example
# Or opt in to single-domain degraded mode when only one domain is available:
# INKADE_SANDBOX_SAME_SITE=false
# Extra parent origins allowed to embed Inkade / sandbox frames (space-separated CSP sources)
# INKADE_FRAME_ANCESTORS=

# Optional: Set to true ONLY on trusted single-user local dev machines to bypass browser login
INKADE_LOCAL_AUTO_AUTH=false

# Optional: Static SPA directory (auto-detects apps/web/dist when built)
# INKADE_WEB_DIST_DIR=./apps/web/dist
# INKADE_DISABLE_STATIC=false
