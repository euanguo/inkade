{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkade",
  "version": "0.1.0",
  "identifier": "app.inkade.desktop",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "beforeDevCommand": "bun run --filter @inkade/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run --filter @inkade/web build && bun run --filter @inkade/desktop build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkade",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      },
      {
        "label": "quick-capture",
        "title": "Inkade Quick Capture",
        "url": "quick-capture.html",
        "width": 560,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["inkade"]
      }
    }
  }
}
